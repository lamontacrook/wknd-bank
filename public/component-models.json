      {
        "component": "select",
        "name": "status",
        "label": "Status",
        "valueType": "string",
        "required": true,
        "description": "Only approved rates display without the Sample rate label",
        "options": [
          {
            "name": "Sample (shows a Sample rate label)",
            "value": "sample"
          },
          {
            "name": "Approved by compliance",
            "value": "approved"
          }
        ],
        "value": "sample"
      },
      {
        "component": "text",
        "name": "ctaText",
        "label": "Link text",
        "valueType": "string"
      },
      {
        "component": "text",
        "name": "ctaLink",
        "label": "Link",
        "valueType": "string",
        "description": "A path (/accounts/checking), full URL, or #anchor on the same page"
