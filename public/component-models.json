    "fields": [
      {
        "component": "text",
        "name": "product",
        "label": "Product",
        "valueType": "string",
        "required": true,
        "description": "e.g. 12-month CD"
      },
      {
        "component": "text",
        "name": "detail",
        "label": "Detail",
        "valueType": "string",
        "description": "Short qualifier, e.g. No minimum balance"
      },
      {
        "component": "number",
        "name": "rate",
        "label": "Rate (%)",
        "valueType": "number",
        "required": true,
        "description": "Percentage as a number, e.g. 4.25. Displayed with two decimals"
      },
      {
        "component": "select",
        "name": "rateType",
        "label": "Rate type",
        "valueType": "string",
        "required": true,
        "options": [
          {
            "name": "APY",
            "value": "APY"
          },
          {
            "name": "APR",
            "value": "APR"
          }
        ],
        "value": "APY"
      },
      {
        "component": "text",
        "name": "term",
        "label": "Term",
        "valueType": "string",
        "description": "e.g. Variable, 12 months"
