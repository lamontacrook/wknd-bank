# Public, non-secret defaults (committed). Override in .env.local or the host's env settings.
# NEXT_PUBLIC_AEM_AUTHOR must be set at build time: it renders the Universal Editor connection meta.
NEXT_PUBLIC_AEM_AUTHOR=https://author-p124903-e1367755.adobeaemcloud.com
NEXT_PUBLIC_AEM_PROJECT=wknd-bank
# Empty = render lib/mock/screen-home.json. Set to the publish origin once the persisted query is live.
NEXT_PUBLIC_AEM_HOST=https://publish-p124903-e1367755.adobeaemcloud.com
# Deployed site; the deck links to it in Universal Editor.
NEXT_PUBLIC_SITE_URL=https://wknd-bank.vercel.app
